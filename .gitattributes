# Store text with LF line endings; Windows-only scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never diff or convert binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
*.dll binary
*.msi binary
*.xpi binary
*.pdf binary
